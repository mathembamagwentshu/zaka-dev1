# ---------------------------------------------------------------------------
# Zaka Lite — environment template. PLACEHOLDERS ONLY. Copy to `.env` (or run `npm run setup`,
# which creates .env and generates the local secrets). Never commit `.env`.
# Full guide: docs/CONFIGURATION.md   ·   Check a configuration: npm run preflight
#
# [server]  read only by the server/worker — never sent to browsers
# [browser] delivered to the payer's browser at runtime (not a secret)
# ---------------------------------------------------------------------------

# [server] REQUIRED. Public base URL of the web app: payer links, Stripe return URLs, webhooks.
APP_URL=http://localhost:3000

# [server] REQUIRED. PostgreSQL (application data + pg-boss job tables).
DATABASE_URL=postgresql://USER@localhost:5432/zaka_dev

# [server] REQUIRED. 32-byte secrets, base64 (openssl rand -base64 32). Rotating them
# invalidates every outstanding payer link.
TOKEN_PEPPER=
TOKEN_ENCRYPTION_KEY=

# [server] REQUIRED. The one test merchant and the HMAC secret shared ONLY with the store backend
# (openssl rand -hex 32). See docs/STORE-INTEGRATION.md.
MERCHANT_ID=demo-merchant
MERCHANT_DISPLAY_NAME=Demo Test Store
MERCHANT_API_SECRET=

# [server] OPTIONAL. Signed order-status callback to the store (https in production). Unset: the
# store polls GET /api/v1/merchant/orders/{orderRef}.
MERCHANT_STATUS_WEBHOOK_URL=

# [server] Enables the clearly labelled demo checkout fixture at /demo-store (sandbox only).
DEMO_STORE_ENABLED=true

# [server] REQUIRED. "stripe" (test keys required) or "simulated" (local development and automated
# tests only; refused when NODE_ENV=production). Never falls back from one to the other.
PAYMENT_PROVIDER=simulated

# Stripe — TEST MODE ONLY. Live keys are refused at start-up. Required when PAYMENT_PROVIDER=stripe.
# [server]  sk_test_… or a restricted rk_test_… key of the platform account
STRIPE_SECRET_KEY=
# [browser] pk_test_… of the same platform account
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# [server]  acct_… the single fixed merchant connected account (direct charges)
STRIPE_CONNECTED_ACCOUNT_ID=
# [server]  whsec_… signing secret of the *Connect* webhook endpoint (or of `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# [server] Simulated provider only: account id and secret for local signed test events.
SIMULATED_ACCOUNT_ID=acct_simulated_merchant
SIMULATED_WEBHOOK_SECRET=whsec_simulated_local_only

# Email. Without RESEND_API_KEY, emails are rendered to the notifications table (OUTBOX) only.
# [server] re_… Resend API key
RESEND_API_KEY=
# [server] Sender on a domain verified in Resend, e.g. Zaka Sandbox <sandbox@your-domain.example>
EMAIL_FROM=Zaka Sandbox <onboarding@resend.dev>
# [server] Comma-separated addresses or @domains allowed to receive sandbox email. Others: SUPPRESSED.
EMAIL_ALLOWLIST=
# [server] OPTIONAL. Internal address alerted when an operator must act (must be allowlisted).
OPS_ALERT_EMAIL=
# [server] Local development only: labelled email preview at /dev/emails (refused in production).
EMAIL_PREVIEW_ENABLED=false

# [server] OPTIONAL. Comma-separated operator names allowed to run mutating `npm run ops` commands.
OPS_OPERATORS=

# [server] Policy. 60 minutes from checkout creation is a sandbox assumption pending owner confirmation.
SESSION_WINDOW_MINUTES=60
# [server] Requests per minute per payer link (polling from a few tabs fits comfortably).
RATE_LIMIT_PER_MINUTE=120

# [server] Controlled fault injection for partial-capture drills. Keep false outside a drill.
FAULT_INJECTION_ENABLED=false
