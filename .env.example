# ---------------------------------------------------------------------------
# Zaka Lite — environment template. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Public base URL of the web app (used to build payer links and Stripe return URLs).
APP_URL=http://localhost:3000

# PostgreSQL (application data + pg-boss job tables).
DATABASE_URL=postgresql://USER@localhost:5432/zaka_dev

# 32-byte secrets, base64. Generate with: openssl rand -base64 32
TOKEN_PEPPER=
TOKEN_ENCRYPTION_KEY=

# Trusted storefront → Zaka checkout API (HMAC-SHA256). Shared only with the store backend.
MERCHANT_ID=demo-merchant
MERCHANT_DISPLAY_NAME=Demo Test Store
MERCHANT_API_SECRET=

# Enables the clearly labelled demo checkout fixture at /demo-store (sandbox only).
DEMO_STORE_ENABLED=true

# Payment provider: "stripe" (test keys required) or "simulated" (local development/tests only;
# refused when NODE_ENV=production).
PAYMENT_PROVIDER=simulated

# Stripe TEST MODE ONLY. Live keys are rejected at startup.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The single fixed merchant connected account (direct charges).
STRIPE_CONNECTED_ACCOUNT_ID=
# Signing secret of the *Connect* webhook endpoint (or `stripe listen --forward-connect-to`).
STRIPE_WEBHOOK_SECRET=

# Simulated provider only: account id and webhook secret used for local signed test events.
SIMULATED_ACCOUNT_ID=acct_simulated_merchant
SIMULATED_WEBHOOK_SECRET=whsec_simulated_local_only

# Email. Without RESEND_API_KEY, emails are rendered to the notifications table (OUTBOX) only.
RESEND_API_KEY=
EMAIL_FROM=Zaka Sandbox <onboarding@resend.dev>
# Comma-separated addresses or @domains allowed to receive sandbox email. Others are SUPPRESSED.
EMAIL_ALLOWLIST=

# Policy (sandbox assumption pending owner confirmation).
SESSION_WINDOW_MINUTES=60

# Controlled fault injection for partial-capture demonstrations. Keep false outside the sandbox.
FAULT_INJECTION_ENABLED=false
